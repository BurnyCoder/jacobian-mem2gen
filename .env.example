# Configuration of the J-lens transport experiments (jtransport/). Copy to .env and edit: cp .env.example .env
# Every key is optional; jtransport/config.py holds the same defaults. Read with python-dotenv
# (https://github.com/theskumar/python-dotenv). No credentials belong here.

# ---- model / data -----------------------------------------------------------------------------------------------
# Short name from distill/common.MODELS (qwen2.5-0.5b = Qwen/Qwen2.5-0.5B-Instruct, fits an 8 GB GPU)
MODEL=qwen2.5-0.5b
# Training seed (848 = the paper's Qwen seed; the injected 1000-fact sample is fixed by make_inject_data.py)
SEED=848
# Injection epochs per training arm (paper: 50). The adapter of the last epoch is saved and patched.
EPOCHS=50
# CUDA device for the in-process phases
DEVICE=cuda

# ---- outputs ----------------------------------------------------------------------------------------------------
# Large artefacts (adapters, Jacobians, grids): gitignored
OUT_ROOT=experiment_logs/jtransport
# Small committed results (JSON, markdown tables, figures)
RESULTS_DIR=results/jtransport
# Timestamped run logs (also mirrored to the terminal)
LOG_DIR=logs

# ---- Jacobian lens fit (jlens.fit, https://github.com/anthropics/jacobian-lens) -----------------------------------
# Pretraining-like corpus, as in the J-lens paper (1000 x 128 tokens there; ~100 prompts is usable)
JLENS_CORPUS=NeelNanda/pile-10k
# Prompts per half; two disjoint halves are fitted (split-half ridge selection) and merged
JLENS_PROMPTS_PER_HALF=80
# Tokens per prompt (jlens default 128)
JLENS_MAX_SEQ_LEN=128
# Output dimensions per backward pass (GPU memory vs. nothing else; total FLOPs unchanged)
JLENS_DIM_BATCH=4

# ---- transport / grid -------------------------------------------------------------------------------------------
# Ridge strengths c (lambda_t = c * sigma_max(J_t)) tried by split-half stability, and the stability threshold tau
RIDGE_GRID=0.1,0.03,0.01,0.003
RIDGE_TAU=0.3
# Questions used for the split-half ridge selection (no answers are used)
RIDGE_QUESTIONS=48
# Arms of the self-patching grid: copy (paper), jlens, noise_copy, noise_jlens, norm
TRANSPORTS=copy,jlens,noise_copy,noise_jlens,norm
# Limit the grid to the first N unique two-hop questions (empty = all)
MAX_QUESTIONS=
# Rows (source layers) per batched forward pass
ROW_BATCH=24

# ---- experiment 2: LRSD vs J-space LRSD -------------------------------------------------------------------------
# Arms trained after the baseline: lrsd (paper loss), jlrsd (J-space loss)
LRSD_ARMS=lrsd,jlrsd
# s-t pair of the distillation loss; auto = round(0.75L)-round(0.5L) (18-12 for 24 layers)
LRSD_PAIR=auto

# ---- which phases to run (comma list; empty = all, in order) -----------------------------------------------------
# make_data,finetune_baseline,fit_lens_finetuned,patch_grids,compare,fit_lens_base,train_lrsd_arms,compare_lrsd
PHASES=
